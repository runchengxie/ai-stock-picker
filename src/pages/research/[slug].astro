---
import { getCollection } from 'astro:content';
import { listResearchNotes } from '../../lib/research-notes';
import ResearchNote from '../../layouts/ResearchNote.astro';

export async function getStaticPaths() {
  const pairs = listResearchNotes(await getCollection('research'));
  return pairs.map((pair) => ({ params: { slug: pair.slug }, props: { note: pair.en } }));
}

const { note } = Astro.props;
---
<ResearchNote note={note} />
