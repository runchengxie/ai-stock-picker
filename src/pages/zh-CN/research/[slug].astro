---
import { getCollection, render } from 'astro:content';
import { listResearchNotes } from '../../../lib/research-notes';

export async function getStaticPaths() {
  const pairs = listResearchNotes(await getCollection('research'));
  return pairs.map((pair) => ({ params: { slug: pair.slug }, props: { note: pair['zh-CN'], translated: pair.en } }));
}

const { note, translated } = Astro.props;
const { Content } = await render(note);
const siteBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={note.data.summary} />
    <title>{note.data.title} · AI Stock Picker 研究</title>
    <link rel="icon" href={`${siteBase}icon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${siteBase}styles.css`} />
    <link rel="stylesheet" href={`${siteBase}research.css`} />
    <script is:inline src={`${siteBase}theme.js`}></script>
  </head>
  <body>
    <header class="header wrap">
      <a class="brand" href={siteBase}>AI Stock Picker<span class="brand-tag">/ 研究</span></a>
      <nav aria-label="研究导航"><a href={`${siteBase}#notes`}>全部研究</a><a href={`${siteBase}tool.html`}>工具介绍</a></nav>
      <label class="language"><span class="sr-only">语言</span><select id="language" aria-label="语言"><option value="en">English</option><option value="zh-CN">中文</option></select></label>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-labelledby="theme-toggle-label"><span class="theme-icon" aria-hidden="true">☾</span><span class="sr-only" id="theme-toggle-label">切换深色模式</span></button>
    </header>
    <main id="main" class="wrap research-main note-page">
      <article><p class="eyebrow">实验笔记 · {note.data.date.toISOString().slice(0, 10)}</p><Content /></article>
      <p><a class="text-link" href={`${siteBase}research/${translated.data.slug}/`} data-paired-locale="en">English</a> · <a class="text-link" href={`${siteBase}zh-CN/research/${note.data.slug}/`} data-paired-locale="zh-CN">简体中文</a></p>
    </main>
    <footer class="wrap footer"><p>仅供历史研究，不构成投资建议，也不是实盘业绩记录。</p></footer>
    <script>
      const picker = document.querySelector<HTMLSelectElement>('#language');
      if (picker) {
        try { picker.value = localStorage.getItem('aipick.locale') === 'zh-CN' ? 'zh-CN' : 'en'; } catch { /* English is the default. */ }
      }
      picker?.addEventListener('change', () => {
        try { localStorage.setItem('aipick.locale', picker.value); } catch { /* Navigation still works without storage. */ }
        const link = document.querySelector<HTMLAnchorElement>(`[data-paired-locale="${picker.value}"]`);
        window.location.href = link?.href ?? document.querySelector<HTMLAnchorElement>('.brand')?.href ?? '/';
      });
    </script>
  </body>
</html>
